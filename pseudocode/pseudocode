MOSES model-1989 pseudocode
by Elias Lindstenz

simulate():
	initialise()
	for each year
		simulate_year()
		year += 1

simulate_year():
	yearly_init()

	for each firm
		yearly_exp()
		yearly_targ()

	for each relative quarter
		simulate_quarter()
		quarter += 1

	for each firm
		yearly_update()

simulate_quarter():
	quarterly_exp()
	prodplan()
	labour_market()
	export_market()
	domestic_market()
	sto_system()

	for each firm
		finalqpqsqm()
		quarterly_cum()

	invfin()
	government_accounting()
	monetary_sector()
	national_accounting()

yearly_init():
	cumgnpcur = 0
	cumgnpfix = 0
	cumexport = 0
	cumimport = 0

	gov.yearly_init()

	for each firm
		yearly_init()

Government::yearly_init():
	cumwtax   = 0
	cumitax   = 0
	cumvatax  = 0
	cumctax   = 0
	cumws     = 0
	cuml      = 0
	cuminv    = 0
	cumpurch  = 0
	cumtrans  = 0
	cumsubs   = 0
	cummprint = 0
	cumint    = 0

Firm::yearly_init():
	cumq    = 0
    cumm    = 0
    cumsu   = 0
    cums    = 0
    cump    = 0
    cumws   = 0
    cuml    = 0
    cuminv  = 0
    cumva   = 0
    cumsnet = 0

Firm::yearly_exp():
	histdp = smp * histdp + (1 - smp) * dp
    histdpdev = smp * histdpdev + (1 - smp) * (dp - expdp)
    histdpdev2 = smp * histdpdev2 + (1 - smp) * (dp - expdp)^2
    expidp = histdp + e1 * histdpdev - e2 * sqrt(histdpdev2)
    expdp = (1 - r) * expidp + r * expxdp

    histdw = smw * histdw + (1 - smw) * dw
    histdwdev = smw * histdwdev + (1 - smw) * (dw - expdw)
    histdwdev2 = smw * histdwdev2 + (1 - smw) * (dw - expdw)^2
    expidw = histdw + e1 * histdwdev + e2 * sqrt(histdwdev2)
    expdw = (1 - r) * expidw + r * expxdw

    histds = sms * histds + (1 - sms) * ds
    histdsdev = sms * histdsdev + (1 - sms) * (ds - expds)
    histdsdev2 = sms * histdsdev2 + (1 - sms) * (ds - expds)^2
    expids = histds + e1 * histdsdev - e2 * sqrt(histdsdev2)
    expds = (1 - r) * expids + r * expxds

Firm::yearly_targ():
	mhist = max(0, smt * mhist + (1 - smt) * m)
	targm = mhist * (1 + eps)

quarterly_exp():
	for each firm
		quarterly_exp()
		quarterly_targ()

	for each market
		quarterly_exp()

	for each external
		quarterly_exp()

Firm::quarterly_exp():
	qexpdp = expdp/4
	qexpdw = expdw/4
	qexpds = expds/4

	if last quarter in year
		qexpdp += fip * (qdp - qexpdp)
		qexpdw += fiw * (qdw - qexpdw)
		qexpds += fis * (qds - qexpds)

	qexpp = qp * (1 + qexpdp)
	qexpw = qw * (1 + qexpdw)
	qexps = qs * (1 + qexpds)

Firm::quarterly_targ():
	qtargm = targm

Market::quarterly_exp():
	qexpdpim = sum(qq * qexpdp) / sum(qq)
	qexppim = (1 - txva2) * qpdom * (1 + qexpdpim)

External::quarterly_exp():
	qexpdpim = qdp - qchtxva2
	qexppim = (1 - txva2) * qpdom * (1 + qexpdpim)

prodplan():
	luupdate()
	prodfront()
	for each firm
		init_prodplan()
		if not target_search()
			nullify_firm()

	if no firms left in a market then
		exit simulation

	for each firm
		qplanqsave = qplanq

luupdate():
	labour.luupdate()
	for each firm
		luupdate()

Labour::luupdate():
	lf = lu + gov.l + sum(firm.l)
	lu *= (1 - ret)
	lu += entry * lf

Firm::luupdate():
	l *= (1 - ret)
	for i = 0 to 3
		aman[i] *= (1 - ret)

prodfront():
	for each market
		mtec *= (1 + qdmtec)

	for each firm
		prodfront()

Firm::prodfront():
	qtop *= (1 - rho)

	qchqtop1 = (1 - loss) * (qinv * inveff) / qp;
	qchqtop2 = min(loss * ((qinv * inveff) / qp) * ((resmax - res) / resmax),
						((resmax - res) / (1 - resmax)) * (qtop + qchqtop1))
	qchqtop = qchqtop1 + qchqtop2

	res = (res * (qtop + qchqtop1) + qchqtop2) / (qtop + qchqtop)
	if res < 0 or res > resmax then
		exit simulation

	tec = (qtop + qchqtop) / ((qtop / tec) + (qchqtop / mtec))
	qtop += qchqtop

Firm::init_prodplan():
	qexpsu = qexps / qexpp;
	qplanq = max(0, qexpsu + (optsto - sto) / (4 * tmsto))

Firm::target_search():
	// matrix multiplication between the firm's market's io and each sector's price
	qexppnet = qexpp - share * (io x (qpdom * (1 - txva2)))

	if qplanq >= qtop * (1 - res) * wtix then
		return plan_implies_recruitment()

	if qplanq > qfr(l) then
		if sat(qplanq, rfq(qplanq)) then
			qplanl = rfq(qplanq)
			handle_layoffs()
			return true
		else
			return false
	
	if sat(qplanq, l) then
		qplanl = l
		handle_layoffs()
		return true
	
	return try_increase_production()

Firm::plan_implies_recruitment():
	if sat(qfr(l), l) then
		solve()
		handle_layoffs()
		return true
	else
		return try_reduce_slack(qfr(l))

Firm::try_increase_production():
	q2 = min(qfr(l), qexpsu + maxsto - sto)
	IF sat(q2, l) THEN
		qplanq = (l * qexpw/4) / ((1 - qtargm) * qexppnet)
		qplanl = l
		handle_layoffs()
		return true
	
	if q2 == qfr(l) then
		return try_reduce_production()

	if sat(q2, rfq(q2)) then
		qplanq = q2
		qplanl = ((1 - qtargm) * q2 * qexppnet) / (qexpw/4)
		handle_layoffs()
		return true
	
	return try_reduce_production()

Firm::try_reduce_production():
	if sat(qplanq, rfq(qplanq) then
		solve()
		handle_layoffs()
		return true
	else
		return try_reduce_slack(qplanq)

Firm::try_reduce_slack(q7):
	IF sat(q7, rfq((1 - res) / (1 - resdown * res) * q7)) THEN
		qplanq = q7
		qplanl = ((1 - qtargm) * q7 * qexppnet) / (qexpw/4)
		res = 1 - (q7 * (1 - res)) / qfr(qplanl)
		handle_layoffs()
		return true

	res *= resdown

	if sat(0, 0) then
		solve()
		handle_layoffs()
		return true
	
	// Production plan could not be found. Firm is nullified after returning false.
	return false

Firm::handle_layoffs():
	layoff = max(0, l - qplanl)
	aman[0] = min(layoff, aman[1])
	aman[1] = min(layoff - aman[0], aman[2])
	aman[2] = layoff - aman[0] - aman[1]

labour_market():
	glabour()
	indalabour()
	for each firm
		planqrevise()

Government::glabour():
	qchl = min(lu, l * ret + qrealchl)
	l += qchl - ret * l
	lu -= qchl

	qdw = qdwind
	qw *= (1 + qdw)

indalabour():
	labour_search()
	labour_update()

labour_search():
	// chl, ww, and ll are temporary vectors
	// ww and chl store each firms' wage and desired change in labour
	// ll stores each firms' labour, and lastly the unemployment pool (lu)
	for each firm
		ww = qw + iota * (qexpw - qw)
		ll = l
		if chm > 0 then
			chl = qplanl - l
		else
			chl = rfq(qplanq) - l
	ll = lu

	sort firms in descending order of chl/ll
	
	repeat niter times
		for each firm
			if chl <= 0 then
				go to next firm
			
			i = this firm
			target = choose_labour_target()

			if target is the unemployment pool then
				handle_successful_attack()
			else
				if ww[i] > ww[target] * (1 - gamma) then
					handle_successful_attack()
				else
					ww[i] += ksi * (ww[target] * (1 + gamma) - ww[i])
	
	for each firm
		qchl = ll - l;
		qchw = ww - qw
	lu = ll

	for each firm
		handle_labour_search_layoffs()

handle_successful_attack():
	now = min(theta * ll[target], chl[i])

	ll[i] += now
	chl[i] -= now

	ll[target] -= now
	if target is a firm then
		chl[target] += now

Firm::handle_labour_search_layoffs():
	exit = max(0, -qchl)
	if exit > aman[0] + aman[1] then
		aman[2] = max(0, aman[2] - (exit - aman[0] - aman[1]))
	if exit > aman[0] then
		aman[1] = max(0, aman[1] - (exit - aman[0]))
	if exit > 0 then
		aman[0] = max(0, aman[0] - exit)

labour_update():
	for each firm
		sack = min(aman[0], max(0, l + qchl - qplanl))
		qchl -= sack
		aman[0] -= sack
		lu += sack
	
	// sum across firms
	qdwind = (sum((l + qchl) * (qw + qchw)) / sum(l + qchl)) / (sum(l * qw) / sum(l)) - 1

	for each firm
		l += qchl
		qdw = qchw/qw
		qw += qchw

	qchru = lu / (lu + gov.l + sum(firm.l)) - ru
	ru += qchru

Firm::planqrevise():
	qplanq = min(qplanq, qfr(l))
	qdq = qplanq/qq - 1
	qq *= (1 + qdq)

	for i = 0 to NSEC
		qimq[i] = max(0, share * io[i] * qplanqsave + (optimsto[i] - imsto[i]) / (4 * tmimsto)
	
	for i = 0 to NSEC
		imsto[i] = min(maximsto[i], imsto[i] + qimq[i] - share * io[i] * qq)
	
	qoptsu = max(0, qq * (qexpsu / (qexpsu + (optsto - sto) / (4 * tmsto))))

export_market():
	for each firm
		adjust_foreign()

	for each market
		qpfor *= (1 + qdpfor)

	for each firm
		qsfor = qsufor * qpfor * (1 + rsubs)

	qsubsfor = sum(qsufor * qpfor * rsubs)
	qexport = sum(qsfor / (1 + rsubs))

Firm::adjust_foreign():
	if qpdom * (1 - txva2) > qpfor then
		x -= x * (1/(4 * tmx)) * (qpdom * (1 - txva2) - qpfor)/qpfor
	else
		x += (1 - x) * (1/(4*tmx)) * (qpfor - qpdom * (1 - txva2)) / (qpdom * (1 - txva2))
	// clamp x between 0 and 1

	qsufor = x * qoptsu

domestic_market():
	market_entrance()
	household.init()
	market_confront()
	compute_imports()
	domestic_result()
	external_sectors()
	household_update()
	indirect_taxes()

market_entrance():
	for each firm
		qoptsudom = (1 - x) * qoptsu
	
	// sum across firms per market
	for each market
		qprelpdom = qpdom * (1 + qchtxva2) * sum(qoptsudom * (qexpp / qp)) / sum(qoptsudom)

Household::init():
	qtrans = (rtrans * qttax) + lu * rlu * wstx / (4 * sum(l))
	qint = rih * wh/4 * nh

	qtws = gov.l * gov.qw/4 + qinpay + sum(firm.l * firm.qw/4)
	qwtax = (gov.l * gov.qw/4) * (txwg / (1 + txwg)) + (qinpay + sum(firm.l * firm.qw/4)) * txw / (1 + txw)
	qti = (qtws - qwtax) + qint + qtrans + qtdiv
	qitax = qti * txi1
	qdi = (qti - qitax) / nh
	qspsavreq = qsavhreq / nh

market_confront():
	for each market
		if (qpdom > qpfor) then
			imp += (1 - imp)/(4 * tmimp) * (qpdom * (1 - txva2) - qpfor)/qpfor
		else
			imp -= imp/(4 * tmimp) * (qpfor - qpdom * (1 - txva2))/(qpdom * (1 - txva2))
		// clamp imp between 0 and 1

		pt = (1 - imp) * qprelpdom + imp * qpfor / (1 - txva2)
	
	for each external
		pt = qpdom * (1 + qdp)
	
	for i = 0 to NSEC
		qpurch[i] = gkoff[i] * gov.l * gov.qw/4 * pt[i] * (wgref/(100 * gov.qw))
	
	repeat marketiter times
		compute_expenditures()
		compute_buying()
		if last iteration then
			for each market
				price_adjust()

Household::compute_expenditures():
	qprelcpi = sum(qc) / sum(qc/pt)
	qchdcpi = qprelcpi/qcpi - 1 - qdcpi

	for each expenditure category except DUR and SAV
		qspe = cva * pt
	
	swap = alfa3 * (qchri/4 - qchdcpi) + alfa4 * qchru
	// clamp swap between -0.05 and 0.05

	qspe[DUR] = max(0, (pt[DUR] * cva[DUR])/rhodur - (pt[DUR]/qp[DUR] * (1 - rhodur) * stodur) - qdi * swap
	qspe[SAV] = (whra * qdi - wh) + qdi * swap

	for each expenditure category
		qsp = beta1 * qspe + (beta2 + ((beta3 * qprelcpi)/(qdi - qspsavreq))) * (qdi - qspsavreq - sum(qspe * beta1))
		if expenditure category is not SAV then
			qsp = max(0, qsp)
	qsp[SAV] += qspsavreq

compute_buying():
	for each market
		for i = 0 to NSEC
			qbuy[i] = sum(qimq[i])

	for i = 0 to NSEC
		gov.qbuy[i] = qpurch[i]/pt[i]
		hh.qbuy[i] = nh * qsp[i]/pt[i]

		qinvtot = omegag[i] * gov.qinv[i] + omegabld[i] * qinvbld + omegain[i] * qinvin + omega[i] * sum(qinvlag)
		bank.qbuy[i] = qinvtot / (pt[i] * (1 - txva2)/(1 - txva1))

	// matrix inversion requires the whole matrix intact. Therefore io3 is constructed temporarily from the externals' ios
	// sum across qbuy is total buying from the external
	for each external
		qq = invert_matrix(I - (io3 * (1 - imp)/(1 - x))) * sum(qbuy * (1 - imp)/(1 - x))
		for i = 0 to NSEC
			qbuy[i] = io[i] * qq
	
	// sum buying from each sector
	for each sector
		qtbuy = sum(qbuy)

Market::price_adjust():
	ch = ((1 - imp) * maxdp * pt)/(4 * (marketiter - 1))
	if qtbuy * (1 - imp) < sum(qoptsudom) then
		pt -= ch
	else
		pt += ch

compute_imports():
	qimport = 0

	for each market
		qtbuyfor1 = imp * qtbuy
		qtbuydom = qtbuy - qtbuyfor1

		qmaxtsudom = max(0, sum(qq + sto - minsto - qsufor))
		qtbuydom = min(qtbuydom, qmaxtsudom)

		qtbuyfor2 = qtbuy - (qtbuydom + qtbuyfor1)
		qtbuyfor = qtbuyfor1 + qtbuyfor2

		qimport += qtbuyfor * qpfor

	for each external
		qtbuyfor = imp * qtbuy
		qtbuydom = qtbuy - qtbuyfor

		qimport += qtbuyfor * ((1 - txva2) * qpdom * (1 + qdp))

Household::household_update():
	for each expenditure category except DUR and SAV
		qc = qsp

	stodur = pt[DUR]/qp[DUR] * stodur + qsp[DUR]
	qc[DUR] = rhodur * stodur
	stodur *= (1 - rhodur)

	qsp[SAV] = qdi - sum(qsp) + qsp[SAV]
	wh += qsp[SAV]
	qsav = qsp[SAV] * nh

	for i = 0 to NSEC
		cva[i] = smooth[i] * cva[i] + (1 - smooth[i]) * qc[i]/pt[i]

	whra = smooth[SAV] * whra + (1 - smooth[SAV]) * wh/qdi

	for i = 0 to NSEC
		qp[i] = pt[i]

	oldqcpi = qcpi
	qcpi = sum(qc) / sum(qc/qp)
	qdcpi = (qcpi - oldqcpi)/oldqcpi

indirect_taxes():
	for each sector
		qvatax = txva2 * (qpurch + nh * qsp)
		if txva1 < 0 then
			more = (qpdom * (1 - txva2))/(1 - txva1) * bank.qbuy
			qvatax += txva1 * more

	qvataximp = sum(qtbuyfor/qtbuy * qvatax)

sto_system():
	firm_sto()
	for each firm
		reference_inventory_levels()

firm_sto():
	for each firm
		limsto = sto + qq - qsufor
		lower = min(limsto, minsto)
		upper = min(limsto, maxsto)

	qsubsdom = 0

	for each market
		totchsto = min(sum(qq - qsufor) - qtsudom, sum(upper - sto))
		qchtsto = totchsto
		qwaste = sum(qq - qsufor) - qtsudom - totchsto

		for each firm in market
			if sto > upper then
				ch = upper - sto
			else
				ch = lower - sto

			sto += ch
			qchsto = ch
			totchsto -= ch

		diff1 = sum(upper - sto)
		diff2 = sum(lower - sto)
		for each firm in market
			if totchsto > 0 then
				ch = (upper - sto)/diff1 * totchsto
			else
				ch = (lower - sto)/diff2 * totchsto

			sto += ch
			qchsto += ch

			qsudom = qq - qsufor - qchsto
			qsdom = qsudom * (1 + rsubs) * qpdom * (1 - txva2)

	qsubsdom = qsubsdom + sum(qsudom * rsubs * qpdom * (1 - txva2))

Firm::reference_inventory_levels():
	j = relative_quarter + 1
	curs = 4 * ((1 / (4 + j)) * (s * (1 + histds/4.0)^(j + 1.5) + cums * (1 + histds/4.0)^((j - 1)/2)))
	curp = (1 / (4 + j)) * 4 * p * (1 + histdp/4.0)^(j + 1.5) + j * cump * (1 + histdp/4.0)^((j - 1)/2))

	minsto = small * curs/curp
	maxsto = big * curs/curp
	optsto = minsto + beta * (maxsto - minsto)

	for i = 0 to NSEC
		minimsto[i] = imsmall * io[i] * share * curs/curp
		maximsto[i] = imbig * io[i] * share * curs/curp
		optimsto[i] = minimsto[i] + imbeta * (maximsto[i] - minimsto[i])

Firm::finalqpqsqm():
	qsu = qsufor + qsudom
	qds = (qsfor + qsdom - qs)/qs
	qs = qsfor + qsdom
	qdp = ((qs/qsu)-qp)/qp
	qp = qs/qsu
	qdva = qq * (qp - sum(io * qpdom * (1 - txva2)) / qva - 1
	qva *= (1 + qdva)
	qsnet = qs - sum(qimq * qpdom * (1 - txva2))
	qm = 1 - (l * qw/4)/qsnet

Firm::quarterly_cum():
	cuminv += qinvlag
	cumq += qq
	cumva += qva
	cums += qs
	cumsu += qsu
	cumsnet += qsnet
	cumws += l * qw/4
	
	j = relative_quarter + 1
	cuml = ((j - 1) * cuml + l)/j

	cumm = 1 - cumws/cumsnet
	cump = cums/cumsu

Firm::invfin():
	qrev = qm * qsnet + (k2 * rik2/4) - (bw * rif/4)
	
	k1 = qinv + k1 * (1 + qdpk)
	qdepr = rho * k1
	k1 -= qdepr

	k1book += qinv
	qdeprbook = max(0, min(qrev, rhobook * k1book))
	k1book -= qdeprbook

	k3imed = sum(imsto * qpdom * (1 - txva2))
	k3finish = sto * qp
	k3 = k3imed + k3finish

	qtax = txc * max(0, qrev - qdeprbook)
	qdiv = rtd * qtax
	qcash = qrev - (qtax + qdiv) + qs * rsubscash

	qrr = 4 * (qrev - qdepr)/(k1 + k2 + k3)
	qdeschk2 = rw * curs - k2

	qdeschbw = max(0, 1 - elinv * (utref - qq/(qtop * wtix * (1 - res)))) * bw * (alfabw + betabw * (qdpk + (qrr - rif)/4))
	qdeschbw = min(qdeschbw, redchbw * bw)	
	qdeschbw *= check_bw((bw + qdeschbw)/(k1 + k2 + qdeschk2 + k3))

	qinv = delay()
	inveff = qtop * qp/k1

Firm::check_bw(bw_ratio):
	val = 1 - bw_ratio
	if val > 0.3 then
		return 1
	else if val <= 0.1 then
		return 0
	else
		return 0.0025 * (floor(100 * val + 0.5) - 10)^2

Firm::delay():
	delta = 1 / (1 + (4 * tminv)/3)

	inv_delay[2] += qinvlag
	inv_delay[1] += delta * inv_delay[2]
	inv_delay[2] -= delta * inv_delay[2]
	inv_delay[0] += delta * inv_delay[1]
	inv_delay[1] -= delta * inv_delay[1]

	ret = delta * inv_delay[0]

	inv_delay[0] *= (1 - delta)

	return ret

Government::accounting():
	j = relative_quarter + 1

	qint = (dep * ridepg/4) - (bw * ribwg/4)
	qintfor = (depfor * ridepgfor/4) - (bwfor * ribwgfor/4)

	qws = l * qw/4
	qsubs = qsubsfor + qsubsdom + qsubscash
	qsp = qws + qsubs + qtrans + sum(qpurch)
	qttax = qwtax + qitax + sum(qvatax) + qctax
	qsurplus = qttax + qint + qintfor - qsp - qinv
	qmprint = max(0, money * 0.25 * sum(s * ds)/sum(s))

	posfor += qchposfor // policy option
	depfor = max(0, pos)
	bwfor = max(0, -posfor)

	qchpos = qsurplus + qmprint - qchposfor
	pos += qchpos
	dep = max(0, pos)
	bw = max(0, -pos)

	cumwtax += qwtax
	cumitax += qitax
	cumvatax += sum(qvatax)
	cumctax += qctax
	cumws += qws
	cuml = (l + cuml * (j - 1))/j
	cumsubs += qsubs
	cumtrans += qtrans
	for i = 0 to NSEC
		cumpurch[i] = qpurch[i]
	cuminv += qinv
	cumint += qint + qintfor
	cummprint += qmprint

	if last quarter in year
		wtax = cumwtax
		itax = cumitax
		vatax = cumvatax
		ctax = cumctax

		dws = cumws/ws - 1
		ws *= (1 + dws)

		dw = cumws/(cuml * w) - 1
		w *= (1 + dw)

		subs = cumsubs
		trans = cumtrans

		for i = 0 to NSEC
			purch[i] = cumpurch[i]

		sp = ws + subs + trans + sum(purch)
		inv = cuminv
		intg = cumint
		surplus = wtax + itax + vatax + ctax + intg - sp - inv
		mprint = cummprint

monetary_sector():
	bank_transactions()
	credit_market()
	invfin_adjustments()

Bank::bank_transactions():
	rfpay = (ri - ribwfor)/maxridiff
	// clamp rfpay between -lamda2 and lamda2

	qfasspay = (fass + qexport)/(1 + 4 * tmfass * (1 - rfpay))
	qchfass = qexport - qfasspay
	fass += qchfass

	qfdpay = (fd + qimport)/(1 + 4 * tmfd * (1 + rfpay))
	qchfd = qimport - qfdpay
	fd += qchfd

	qchliqbfor = qfasspay + gov.qintfor - qfdpay - gov.qchposfor
	liqbfor += qchliqbfor

	qchliqb = qintf + qsav + gov.qchpos + qimport + gov.qchposfor - qintk2 - hh.qint - gov.qint - qexport - gov.qintfor

Bank::credit_market():
	qdemfund = max(0, -gov.qchpos) + sum(max(0, qdeschbw))
	
	qsupfund1 = (liqb + qchliqb + sum(qdeschk2) - rfund1 * (sum(bw) + gov.bw + max(0, -wh * nh)))/(1 + rfund1)
	qsupfund2 = liqb + qchliqb + sum(qdeschk2) - rfund2 * (sum(k2 + qdeschk2) + gov.dep + max(0, wh * nh))
	qsupfund = max(0, min(qsupfund1, qsupfund2))

	qsavhreq = min(kappa1 * max(0, qdi * nh), max(0, qdemfund - qsupfund))

	qredtbw = min(kappa2 * sum(max(0, qdeschbw)), max(0, qdemfund - qsupfund - qsavhreq))
	for each firm
		qchbw = qdeschbw - qredtbw * max(0, qdeschbw)/sum(max(0, qdeschbw))

	qchri = lamda1 * (qdemfund - qsupfund)/(max(1, qdemfund))
	// clamp qchri between -maxqchri and maxqchri

	ri += qchri
	// clamp ri between minri and maxri

	rif = ri
	rih = ri - mb
	rik2 = ri - mb

	ribwg = ri
	ridepg = ri - mb
	ribwgfor = ribwfor
	ridepgfor = ridepfor

invfin_adjustments():
	oldinv = sum(qinvlag)

	for each firm
		bw += qchbw

		qinvlag = max(0, qcash + qchbw - qdeschk2)
		qchk2 = qcash + qchbw - qinvlag
		k2 += qchk2

		nw = k1 + k2 + k3 - bw
		if nw < 0 then
			bad += 1
		if bad >= 6
			nullify_firm()

	if no firms left in a market then
		exit simulation

	qtchbw = sum(qchbw)
	qtchinv = sum(qinvlag) - oldinv
	qtchk2 = sum(qchk2)

Bank::bank_update():
	qchliqb += qtchk2 - qtchbw
	liqb += qchliqb

	assets = sum(bw) + fass + liqbfor + liqb
	liabilities = sum(k2) + wh * nh + gov.pos + fd
	nw = assets - liabilities

	money = sum(k2) + gov.dep + wh * nh

national_accounting():
	// Fill first 10 values of qgnpcur and qgnpfix with sector production
	for each market
		qchtstocurf = sum(k3finish) - tstocurf
		tstocurf += qchtstocurf

		qchtstocurm = sum(sto * qpdom) - tstocurm
		tstocurm += qchtstocurm

		qgnpcur[id] = sum(qsnet) + qchtstocurf
		qgnpfix[id] = pref * (sum(qq) - qwaste)

	for each external
		qgnpcur[id] = qva
		qgnpfix[id] = pref * qq

	// Indirect taxes
	qgnpcur[10] = sum(qvatax) + sum(qchtstocurm) - sum(qchtstocurf) - qvataximp

	// Subsidies
	qgnpcur[11] = -qsubs - qsubscash

	// Government wages
	qgnpcur[12] = gov.qws

	// Government purchases
	qgnpcur[13] = sum(qpurch)

	// Private Consumption
	qgnpcur[14] = nh * sum(qsp) - qsav

	// Investments made by the explicit model sectors
	qgnpcur[15] = sum(qinvlag) - qtchinv

	// Investments made by external sectors, exclusive of housing
	qgnpcur[16] = qinvin

	// Investments for residential construction
	qgnpcur[17] = qinvbld

	// Government investments
	qgnpcur[18] = gov.qinv

	// Inventory changes
	qgnpcur[19] = sum(qchtstocurm)

	// Exports
	qgnpcur[20] = qexport

	// Imports
	qgnpcur[21] = -(qimport - qvataximp)


	// Government wages, deflated to the government wage level of ther reference year
	qgnpfix[10] = gov.l * wgref/4

	// Government purchases
	qgnpfix[11] =  sum(pref * qpurch / qpdom)

	// Private consumption; sum over non-saving categories	
	qgnpfix[12] = sum(pref * qsp * nh / qpdom)

	// Investments made by the explicit model sectors
	qgnpfix[13] = sum(pref * omega * (sum(qinvlag) - qtchinv))/(qpdom * (1 - txva2)/(1 - txva1))

	// Investments made by the external sectors, exclusive of housing
	qgnpfix[14] = sum(pref * omegain * qinvin)/(qpdom * (1 - txva2)/(1 - txva1))

	// Investments for residential construction
	qgnpfix[15] = sum(pref * omegabld * qinvbld)/(qpdom * (1 - txva2)/(1 - txva1))

	// Government investments
	qgnpfix[16] = sum(pref * omegag * gov.qinv)/(qpdom * (1 - txva2)/(1 - txva1))

	// Inventory changes
	qgnpfix[17] = sum(pref * qchtsto)

	// Exports
	qgnpfix[18] = sum(pref * sum(qsufor)) + sum(pref * x * qq)
	// the first sum is across markets, the second sum is across externals
	
	// Imports
	qgnpfix[19] = -sum(pref * qtbuyfor)


	for i = 0 to length of gnpcur
		cumgnpcur[i] += qgnpcur[i]
	for i = 0 to length of gnpfix
		cumgnpfix[i] += qgnpfix[i]
	cumexport += qexport
	cumimport += qimport

	if last quarter in year
		gnpcur = cumgnpcur
		gnpfix = cumgnpfix
		export = cumexport
		import = cumimport

Firm::yearly_update():
	dq = cumq/q - 1;
	q *= (1 + dq);
	dp = cums/(cumsu * p) - 1;
	p *= (1 + dp);
	dw = cumws/(cuml * w) - 1;
	w *= (1 + dw);
	ds = cums/s - 1;
	s *= (1 + ds);
	dva = cumva/va - 1;
	va *= (1 + dva);
	snet = cumsnet;
	chm = cumm - m;
